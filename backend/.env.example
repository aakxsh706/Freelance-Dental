# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dev default (leave unset) uses SQLite at backend/db.sqlite3.
# For production, set a Postgres URL, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:6565,http://127.0.0.1:6565

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Seed data (used only by `manage.py seed_clinic`, the one-time dentist login setup)
DENTIST_USERNAME=drbelin
DENTIST_EMAIL=dentist@belinsdental.example
DENTIST_PASSWORD=change-this-password

# Email — appointment confirmation / reschedule / cancellation notices.
# Leave EMAIL_BACKEND unset in development: it defaults to Django's console
# backend while DEBUG=True, printing emails to the runserver output instead of
# sending them, so no real patient is ever emailed from a dev machine.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Belin's Dental Clinic <no-reply@belinsdental.example>
