# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dev default (leave unset) uses SQLite at backend/db.sqlite3.
# For production, set a Postgres URL, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:6565,http://127.0.0.1:6565

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Seed data (used only by `manage.py seed_clinic`, the one-time dentist login setup)
DENTIST_USERNAME=drbelin
DENTIST_EMAIL=dentist@belinsdental.example
DENTIST_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# Email — appointment acknowledgement / confirmation / reschedule / cancellation
# ---------------------------------------------------------------------------
# Leave EMAIL_BACKEND unset and emails are PRINTED TO THE TERMINAL, not sent.
# That is the default while DEBUG=True so a development machine can never mail
# a real patient by accident. The clinic screens say so explicitly rather than
# claiming the message was delivered.
#
# To send real email, uncomment EMAIL_BACKEND and fill in the rest.
#
# Gmail: an ordinary account password will NOT work. Create an App Password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create one for "Mail", and paste the 16 characters below (spaces are
#      fine to remove).
# Use a dedicated clinic address, not a personal one - the From address is what
# patients see and reply to.

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Must be the authenticated Gmail address, or Google rewrites or rejects it.
DEFAULT_FROM_EMAIL=Belin's Dental Clinic <your-clinic-address@gmail.com>
