# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dev default (leave unset) uses SQLite at backend/db.sqlite3.
# For production, set a Postgres URL, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:6565,http://127.0.0.1:6565

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Seed data (used only by `manage.py seed_clinic`, the one-time dentist login setup)
DENTIST_USERNAME=drbelin
DENTIST_EMAIL=dentist@belinsdental.example
DENTIST_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# Email — appointment acknowledgement / confirmation / reschedule / cancellation
# ---------------------------------------------------------------------------
# Leave EMAIL_BACKEND unset and emails are PRINTED TO THE TERMINAL, not sent.
# That is the default while DEBUG=True so a development machine can never mail
# a real patient by accident. The clinic screens say so explicitly rather than
# claiming the message was delivered.
#
# To send real email, uncomment EMAIL_BACKEND and fill in the rest.
#
# Gmail: an ordinary account password will NOT work. Create an App Password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create one for "Mail", and paste the 16 characters below (spaces are
#      fine to remove).
# Use a dedicated clinic address, not a personal one - the From address is what
# patients see and reply to.

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
# Must be the authenticated Gmail address, or Google rewrites or rejects it.
DEFAULT_FROM_EMAIL=Dr. Belin's Dentistry <your-clinic-address@gmail.com>

# --- Patient sheet sync ------------------------------------------------------
# The clinic runs offline. Patient CONTACT DETAILS ONLY (code, name, phone,
# email, city) are pushed to a Google Sheet whenever the machine has a
# connection. No clinical data is sent.
#
# The receiving end is an Apps Script web app bound to the sheet - the script
# is in docs/patient_sheet_webhook.gs. Setup is in README.md.
#
# The TOKEN below must match the TOKEN at the top of that script. It is the
# only thing guarding the URL, because the deployment has to be reachable
# without a Google login.

PATIENT_SHEET_WEBHOOK_URL=
PATIENT_SHEET_WEBHOOK_TOKEN=generate-a-long-random-string

# --- Appointment sheet sync --------------------------------------------------
# The reverse direction from the patient sheet sync above: the public
# website's booking form writes rows into a Google Sheet, and this backend
# periodically PULLS new rows from it and turns each into a real Appointment.
# The script is in docs/appointment_sheet_poll.gs - setup is in README.md.
#
# Pull, not push: the clinic PC runs offline behind a router with no public
# IP, so a push FROM Google could never reach back in. The clinic PC can
# already make outbound calls to Google (see the patient sheet sync above),
# so it asks instead of waiting to be told.
#
# APPOINTMENT_SHEET_POLL_URL is the Apps Script Web app's URL (its doGet
# endpoint). APPOINTMENT_SHEET_TOKEN must match the TOKEN at the top of that
# script - it is the only thing guarding it, since the deployment has to be
# reachable without a Google login. Leaving either blank skips polling
# entirely rather than polling with no way to authenticate.

APPOINTMENT_SHEET_POLL_URL=
APPOINTMENT_SHEET_TOKEN=generate-a-long-random-string

# How often the clinic PC polls the sheet while the software is running (the
# background loop started by backend/run_server.py). A one-time poll also
# happens at startup, before this loop begins - see start-clinic.bat/.sh.
APPOINTMENT_SHEET_POLL_INTERVAL_SECONDS=300
