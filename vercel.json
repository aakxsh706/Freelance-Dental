{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Nothing to build - the frontend and static files are committed.'",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
