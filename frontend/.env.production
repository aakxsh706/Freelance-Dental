# Production build for the public website.

# No backend: the site is static. Bookings go straight to the clinic's Google
# Apps Script, which appends a row to the Bookings sheet.
VITE_BOOKING_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwbEjX1fsn-LqeoDt3sNNqJ8Wl_7CuxLdSF1vOQCp2Fmq7u2FPudDsXcqUmKbdcyaJJWA/exec

# Left empty on purpose. With no API the staff portal cannot work on the
# public site - the clinic uses the installed Windows software for that.
VITE_API_BASE_URL=

# Public build: the staff portal routes are left out entirely. The clinic uses
# the installed Windows software for that.
VITE_PUBLIC_SITE=true
